# App
# Required (no default). The server refuses to boot if this is unset so a deploy
# can't silently run with dev-only permissive CORS/CSP. Use "production" in prod.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ed@localhost:55433/ed_employee_directory

# Auth0 API verification
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://ed.itatti.harvard.edu/api
AUTH0_ROLES_CLAIM=https://itatti.harvard.edu/roles
AUTH0_STAFF_ROLE=staff-IT

# Optional read-only machine-to-machine access for /api/v1.
# SECURITY: this scope is only a real access boundary if the Auth0 API has RBAC
# enabled AND "Add Permissions in the Access Token" turned on. Without that,
# Auth0 echoes any scope the client requests, so any tenant user could obtain
# `read:ed` and read the directory. Verify this on the live tenant.
AUTH0_READ_SCOPE=read:ed

# Scope required by the time-off directory's preferred-language endpoint, the only
# write ED exposes to a machine-to-machine caller. Kept distinct from
# AUTH0_READ_SCOPE so the Ferie portal's read-only sync token cannot mutate data.
AUTH0_WRITE_SCOPE=write:time-off-directory

# Application-role grants for the Ferie projection, as
# "<employeeNumber>:<ROLE>|<ROLE>,<employeeNumber>:<ROLE>". ED has no
# application-role master data, so an empty value means the portal syncs everyone
# with no roles — leaving nobody able to administer it. Valid roles:
# FERIE_FINAL_APPROVER, FERIE_PORTAL_ADMIN, STAFF_IT. A malformed value or unknown
# role stops the server at boot.
TIME_OFF_DIRECTORY_ROLES=

# Local development escape hatch — uncomment ONLY for local dev.
# The frontend renders a staff-IT demo user and the backend accepts it.
# The server refuses to boot if either is true while NODE_ENV=production.
# DEV_SKIP_AUTH=true
# VITE_DEV_SKIP_AUTH=true
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://ed.itatti.harvard.edu/api
VITE_AUTH0_CALLBACK_URL=http://localhost:5173
VITE_AUTH0_ROLES_CLAIM=https://itatti.harvard.edu/roles
