{
  "name": "itatti-ed-employee-directory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @itatti/server dev & pnpm --filter @itatti/web dev",
    "dev:server": "pnpm --filter @itatti/server dev",
    "dev:web": "pnpm --filter @itatti/web dev",
    "build": "pnpm --filter @itatti/shared build && pnpm --filter @itatti/server build && pnpm --filter @itatti/web build",
    "build:web": "pnpm --filter @itatti/web build",
    "build:server": "pnpm --filter @itatti/server build",
    "db:generate": "pnpm --filter @itatti/server db:generate",
    "db:migrate": "pnpm --filter @itatti/server db:migrate",
    "db:push": "pnpm --filter @itatti/server db:push",
    "db:deploy": "pnpm --filter @itatti/server db:deploy",
    "db:studio": "pnpm --filter @itatti/server db:studio",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
